# Clinical Drug Safety Engine — Environment Example
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------
# GROQ API — Primary LLM source (FREE at console.groq.com)
# -----------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# Model options (all free on Groq):
#   llama-3.3-70b-versatile  → Best quality, ~2-4s  [RECOMMENDED]
#   llama-3.1-8b-instant     → Fastest, ~0.5-1s
#   mixtral-8x7b-32768       → Good structured output
GROQ_MODEL=llama-3.3-70b-versatile

# Inference settings (do not change unless needed)
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT_SECONDS=30.0
GROQ_MAX_RETRIES=2
